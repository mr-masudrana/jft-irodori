      "title": "会話 1: お久しぶりです",
      "lines": [
        {
          "speaker": "A",
          "jp": "あ、お久しぶりです。",
          "bn": "আরে, অনেক দিন পর দেখা!"
        },
        {
          "speaker": "B",
          "jp": "お久しぶりです。",
          "bn": "অনেক দিন পর দেখা।"
        },
        {
          "speaker": "A",
          "jp": "お元気ですか？",
          "bn": "কেমন আছেন?"
        },
        {
          "speaker": "B",
          "jp": "はい、おかげさまで。",
          "bn": "হ্যাঁ, ভালো আছি।"
        }
      ]
    },
    {
      "id": "d2",
      "title": "会話 2: 日本に来てどのぐらいですか？",
      "lines": [
        {
          "speaker": "A",
          "jp": "日本に来て、どのぐらいになりますか？",
          "bn": "জাপানে এসে কত দিন হলো?"
        },
        {
          "speaker": "B",
          "jp": "1年になります。",
          "bn": "১ বছর হলো।"
        },
        {
          "speaker": "A",
          "jp": "日本の生活に、もう慣れましたか？",
          "bn": "জাপানের জীবনে কি অভ্যস্ত হয়েছেন?"
        },
        {
          "speaker": "B",
          "jp": "はい。",
          "bn": "হ্যাঁ।"
        }
      ]
    }
