{
  "id": "starter-l1",
  "lessonNumber": 1,
  "title": "Good morning!",
  "titleBn": "শুভ সকাল!",
  "topic": "Starting to Speak Japanese",
  "activities": [
    {
      "no": 1,
      "title": "こんにちは",
      "canDo": "Can exchange greetings when you meet someone.",
      "dialogues": [
        {
          "id": "s1-02",
          "title": "1-① こんにちは",
          "audio": "/audio/starter/01-02.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            },
            {
              "speaker": "B",
              "jp": "ああ、こんにちは。",
              "bn": "ও, শুভ দিন।"
            }
          ]
        },
        {
          "id": "s1-03",
          "title": "1-② 朝のあいさつ（丁寧）",
          "audio": "/audio/starter/01-03.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "おはようございます。",
              "bn": "শুভ সকাল।"
            },
            {
              "speaker": "B",
              "jp": "おはようございます。",
              "bn": "শুভ সকাল।"
            }
          ]
        },
        {
          "id": "s1-04",
          "title": "1-③ 夜のあいさつ",
          "audio": "/audio/starter/01-04.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "こんばんは。",
              "bn": "শুভ সন্ধ্যা।"
            },
            {
              "speaker": "B",
              "jp": "あ、こんばんは。",
              "bn": "ও, শুভ সন্ধ্যা।"
            }
          ]
        },
        {
          "id": "s1-05",
          "title": "1-④ 朝のあいさつ（カジュアル）",
          "audio": "/audio/starter/01-05.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "おはよう。",
              "bn": "সুপ্রভাত।"
            },
            {
              "speaker": "B",
              "jp": "おはよう。",
              "bn": "সুপ্রভাত।"
            }
          ]
        }
      ]
    },
    {
      "no": 2,
      "title": "お先に失礼します",
      "canDo": "Can say goodbye when leaving.",
      "dialogues": [
        {
          "id": "s1-10",
          "title": "2-① じゃあ、また。",
          "audio": "/audio/starter/01-10.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "じゃあ、また。",
              "bn": "তাহলে, আবার দেখা হবে।"
            },
            {
              "speaker": "B",
              "jp": "じゃあ、また。",
              "bn": "আবার দেখা হবে।"
            }
          ]
        },
        {
          "id": "s1-11",
          "title": "2-② 失礼します",
          "audio": "/audio/starter/01-11.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "じゃあ、また。",
              "bn": "তাহলে, আবার দেখা হবে।"
            },
            {
              "speaker": "B",
              "jp": "失礼します。",
              "bn": "আমি আসি (বিনয়ের সাথে)।"
            }
          ]
        },
        {
          "id": "s1-12",
          "title": "2-③ 職場でのあいさつ",
          "audio": "/audio/starter/01-12.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "お先に失礼します。",
              "bn": "আমি আগে যাচ্ছি।"
            },
            {
              "speaker": "B",
              "jp": "あ、お疲れさまでした。",
              "bn": "ও, আপনার পরিশ্রমের জন্য ধন্যবাদ।"
            },
            {
              "speaker": "C",
              "jp": "お疲れさま。",
              "bn": "পরিশ্রমের জন্য ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s1-13",
          "title": "2-④ 夜の別れ",
          "audio": "/audio/starter/01-13.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "じゃあ、また。おやすみ。",
              "bn": "আবার দেখা হবে। শুভ রাত্রি।"
            },
            {
              "speaker": "B",
              "jp": "おやすみなさい。",
              "bn": "শুভ রাত্রি।"
            }
          ]
        }
      ]
    },
    {
      "no": 3,
      "title": "ありがとうございます",
      "canDo": "Can thank someone or apologize to them.",
      "dialogues": [
        {
          "id": "s1-18",
          "title": "3-① ありがとうございます",
          "audio": "/audio/starter/01-18.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "ありがとうございます。",
              "bn": "ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s1-19",
          "title": "3-② 落とし物",
          "audio": "/audio/starter/01-19.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、落としましたよ。",
              "bn": "এটা আপনি ফেলে দিয়েছেন।"
            },
            {
              "speaker": "B",
              "jp": "あ、すみません。",
              "bn": "ও, ধন্যবাদ / দুঃখিত।"
            }
          ]
        },
        {
          "id": "s1-20",
          "title": "3-③ どうぞ",
          "audio": "/audio/starter/01-20.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "どうぞ。",
              "bn": "নিন / বসুন।"
            },
            {
              "speaker": "B",
              "jp": "あ、すみません。ありがとうございます。",
              "bn": "ও, ধন্যবাদ।"
            },
            {
              "speaker": "A",
              "jp": "いいえ。",
              "bn": "না, কিছু না।"
            }
          ]
        },
        {
          "id": "s1-21",
          "title": "3-④ あめ",
          "audio": "/audio/starter/01-21.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あめ、どうぞ。",
              "bn": "ক্যান্ডি নিন।"
            },
            {
              "speaker": "B",
              "jp": "あ、どうも。",
              "bn": "ও, ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s1-22",
          "title": "3-⑤ プレゼント",
          "audio": "/audio/starter/01-22.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、プレゼント。",
              "bn": "এটা উপহার।"
            },
            {
              "speaker": "B",
              "jp": "わあ、どうもありがとう。",
              "bn": "ওয়া, অনেক ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s1-23",
          "title": "3-⑥ 痛い！",
          "audio": "/audio/starter/01-23.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "痛い！",
              "bn": "উফ, ব্যথা!"
            },
            {
              "speaker": "B",
              "jp": "あ、すみません。",
              "bn": "ও, দুঃখিত।"
            }
          ]
        },
        {
          "id": "s1-24",
          "title": "3-⑦ ごめん",
          "audio": "/audio/starter/01-24.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あ、ごめん！",
              "bn": "ও, সরি!"
            },
            {
              "speaker": "B",
              "jp": "あー！",
              "bn": "আহ!"
            }
          ]
        },
        {
          "id": "s1-25",
          "title": "3-⑧ すみません……",
          "audio": "/audio/starter/01-25.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "すみません……。",
              "bn": "দুঃখিত…"
            }
          ]
        }
      ]
    },
