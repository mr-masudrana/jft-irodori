      "dialogues": [
        {
          "id": "s2-01",
          "title": "1-① 在留カード",
          "lines": [
            {
              "speaker": "A",
              "jp": "在留カード、見せてください。",
              "bn": "রেসিডেন্স কার্ড দেখান।"
            },
            {
              "speaker": "B",
              "jp": "すみません。よくわかりません。",
              "bn": "দুঃখিত, ভালো বুঝলাম না।"
            },
            {
              "speaker": "A",
              "jp": "えー、在留カード、レジデンスカードです。",
              "bn": "মানে, রেসিডেন্স কার্ড।"
            },
            {
              "speaker": "B",
              "jp": "あ、はい。",
              "bn": "ও, জি।"
            }
          ]
        },
        {
          "id": "s2-02",
          "title": "1-② 名前を書く",
          "lines": [
            {
              "speaker": "A",
              "jp": "ここ、名前、書いてください。",
              "bn": "এখানে নাম লিখুন।"
            },
            {
              "speaker": "B",
              "jp": "すみません。もう少し、ゆっくり言ってください。",
              "bn": "দুঃখিত, আরেকটু ধীরে বলুন।"
            },
            {
              "speaker": "A",
              "jp": "ここ、名前、書いてください。",
              "bn": "এখানে নাম লিখুন।"
            },
            {
              "speaker": "B",
              "jp": "あ、わかりました。",
              "bn": "ও, বুঝেছি।"
            }
          ]
        },
        {
          "id": "s2-03",
          "title": "1-③ 部屋は213です",
          "lines": [
            {
              "speaker": "A",
              "jp": "部屋は、213です。",
              "bn": "ঘর নম্বর ২১৩।"
            },
            {
              "speaker": "B",
              "jp": "すみません。もういちど、お願いします。",
              "bn": "দুঃখিত, আরেকবার বলুন।"
            },
            {
              "speaker": "A",
              "jp": "部屋は、213です。",
              "bn": "ঘর নম্বর ২১৩।"
            },
            {
              "speaker": "B",
              "jp": "わかりました。ありがとうございます。",
              "bn": "বুঝেছি, ধন্যবাদ।"
            }
          ]
        }
