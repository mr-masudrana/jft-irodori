{
  "id": "starter-l2",
  "lessonNumber": 2,
  "title": "I'm sorry, I don't really understand.",
  "titleBn": "দুঃখিত, আমি ঠিক বুঝতে পারিনি।",
  "topic": "Starting to Speak Japanese",
  "activities": [
    {
      "no": 1,
      "title": "もういちど、お願いします",
      "canDo": "Can ask someone to say something again if you don't really understand.",
      "dialogues": [
        {
          "id": "s2-01",
          "title": "1-① 在留カード",
          "audio": "/audio/starter/02-01.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "在留カード、見せてください。",
              "bn": "রেসিডেন্স কার্ড দেখান।"
            },
            {
              "speaker": "B",
              "jp": "すみません。よくわかりません。",
              "bn": "দুঃখিত, ভালো বুঝলাম না।"
            },
            {
              "speaker": "A",
              "jp": "えー、在留カード、レジデンスカードです。",
              "bn": "মানে, রেসিডেন্স কার্ড।"
            },
            {
              "speaker": "B",
              "jp": "あ、はい。",
              "bn": "ও, জি।"
            }
          ]
        },
        {
          "id": "s2-02",
          "title": "1-② 名前を書く",
          "audio": "/audio/starter/02-02.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "ここ、名前、書いてください。",
              "bn": "এখানে নাম লিখুন।"
            },
            {
              "speaker": "B",
              "jp": "すみません。もう少し、ゆっくり言ってください。",
              "bn": "দুঃখিত, আরেকটু ধীরে বলুন।"
            },
            {
              "speaker": "A",
              "jp": "ここ、名前、書いてください。",
              "bn": "এখানে নাম লিখুন।"
            },
            {
              "speaker": "B",
              "jp": "あ、わかりました。",
              "bn": "ও, বুঝেছি।"
            }
          ]
        },
        {
          "id": "s2-03",
          "title": "1-③ 部屋は213です",
          "audio": "/audio/starter/02-03.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "部屋は、213です。",
              "bn": "ঘর নম্বর ২১৩।"
            },
            {
              "speaker": "B",
              "jp": "すみません。もういちど、お願いします。",
              "bn": "দুঃখিত, আরেকবার বলুন।"
            },
            {
              "speaker": "A",
              "jp": "部屋は、213です。",
              "bn": "ঘর নম্বর ২১৩।"
            },
            {
              "speaker": "B",
              "jp": "わかりました。ありがとうございます。",
              "bn": "বুঝেছি, ধন্যবাদ।"
            }
          ]
        }
      ]
    },
    {
      "no": 2,
      "title": "日本語、できますか？",
      "canDo": "Can answer when someone asks if you speak Japanese and ask if someone speaks other languages.",
      "dialogues": [
        {
          "id": "s2-07",
          "title": "2-① おでん屋で",
          "audio": "/audio/starter/02-07.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "はい、どうぞ。",
              "bn": "নিন।"
            },
            {
              "speaker": "B",
              "jp": "どうも。",
              "bn": "ধন্যবাদ।"
            },
            {
              "speaker": "A",
              "jp": "お客さん、日本語、できますか？",
              "bn": "আপনি কি জাপানিজ বলতে পারেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、少しできます。",
              "bn": "হ্যাঁ, একটু পারি।"
            }
          ]
        },
        {
          "id": "s2-08",
          "title": "2-② 役所で",
          "audio": "/audio/starter/02-08.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、読んでください。日本語、わかりますか？",
              "bn": "এটা পড়ুন। জাপানিজ বোঝেন?"
            },
            {
              "speaker": "B",
              "jp": "すみません。わかりません。",
              "bn": "দুঃখিত, বুঝি না।"
            },
            {
              "speaker": "A",
              "jp": "じゃあ、英語、わかりますか？",
              "bn": "তাহলে ইংরেজি বোঝেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、わかります。",
              "bn": "হ্যাঁ, বুঝি।"
            }
          ]
        },
        {
          "id": "s2-09",
          "title": "2-③ テーマパークで",
          "audio": "/audio/starter/02-09.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、中国語、できますか？",
              "bn": "মানে, চীনা ভাষা পারেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、できます。我可以幫你嗎？",
              "bn": "হ্যাঁ, পারি। (চীনা: আমি কি সাহায্য করব?)"
            }
          ]
        },
        {
          "id": "s2-10",
          "title": "2-④ インドネシア料理店で",
          "audio": "/audio/starter/02-10.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、インドネシア語、わかりますか？",
              "bn": "মানে, ইন্দোনেশিয়ান বোঝেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、少し。Apa kabar?",
              "bn": "হ্যাঁ, একটু। (কেমন আছেন?)"
            }
          ]
        }
      ]
    },
    {
      "no": 3,
      "title": "これは日本語で何と言いますか？",
      "canDo": "Can ask how to say something in Japanese and understand the answer.",
      "dialogues": [
        {
          "id": "s2-17",
          "title": "3-① 傘",
          "audio": "/audio/starter/02-17.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、これは、日本語で何ですか？",
              "bn": "এটা জাপানিজে কী?"
            },
            {
              "speaker": "B",
              "jp": "傘です。",
              "bn": "ছাতা।"
            },
            {
              "speaker": "A",
              "jp": "すみません。もう少し、ゆっくり言ってください。",
              "bn": "দুঃখিত, আরেকটু ধীরে বলুন।"
            },
            {
              "speaker": "B",
              "jp": "傘。",
              "bn": "কাসা।"
            },
            {
              "speaker": "A",
              "jp": "ありがとうございます。",
              "bn": "ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s2-18",
          "title": "3-② スマホ",
          "audio": "/audio/starter/02-18.mp3",
          "lines": [
            {
              "speaker": "B",
              "jp": "スマホですよ。",
              "bn": "স্মার্টফোন।"
            },
            {
              "speaker": "A",
              "jp": "すみません。もういちど、お願いします。",
              "bn": "দুঃখিত, আরেকবার বলুন।"
            },
            {
              "speaker": "B",
              "jp": "スマホ。",
              "bn": "সুমাহো।"
            },
            {
              "speaker": "A",
              "jp": "ありがとうございます。",
              "bn": "ধন্যবাদ।"
            }
          ]
        },
        {
          "id": "s2-19",
          "title": "3-③ 免許証",
          "audio": "/audio/starter/02-19.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、「driver's license」は、日本語で何と言いますか？",
              "bn": "\"driver's license\" জাপানিজে কী বলে?"
            },
            {
              "speaker": "B",
              "jp": "ああ、免許証です。",
              "bn": "ও, মেনকিওশো।"
            },
            {
              "speaker": "A",
              "jp": "すみません。もう少し、ゆっくり言ってください。",
              "bn": "দুঃখিত, আরেকটু ধীরে বলুন।"
            },
            {
              "speaker": "B",
              "jp": "めんきょしょう。",
              "bn": "মেনকিওশো।"
            },
            {
              "speaker": "A",
              "jp": "めんきょしょう。わかりました。",
              "bn": "মেনকিওশো। বুঝেছি।"
            }
          ]
        },
        {
          "id": "s2-20",
          "title": "3-④ 蚊",
          "audio": "/audio/starter/02-20.mp3",
          "lines": [
            {
              "speaker": "B",
              "jp": "あー。",
              "bn": "আহ।"
            },
            {
              "speaker": "A",
              "jp": "「Mosquito」は、日本語で何ですか？",
              "bn": "\"Mosquito\" জাপানিজে কী?"
            },
            {
              "speaker": "B",
              "jp": "蚊です。",
              "bn": "কা (মশা)।"
            },
            {
              "speaker": "A",
              "jp": "え？ もういちど、お願いします。",
              "bn": "এ? আরেকবার বলুন।"
            },
            {
              "speaker": "B",
              "jp": "「か」です。",
              "bn": "\"কা\"।"
            },
            {
              "speaker": "A",
              "jp": "か？",
              "bn": "কা?"
            },
            {
              "speaker": "B",
              "jp": "そうそう。",
              "bn": "ঠিক ঠিক।"
            }
          ]
        }
      ]
    }
  ],
