    {
      "no": 3,
      "title": "これは日本語で何と言いますか？",
      "canDo": "Can ask how to say something in Japanese and understand the answer.",
      "dialogues": [
        {
          "id": "s2-17",
          "title": "3-① 傘",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、これは、日本語で何ですか？",
              "bn": "এটা জাপানিজে কী?"
            },
            {
              "speaker": "B",
              "jp": "傘です。",
              "bn": "ছাতা।"
            },
            {
              "speaker": "A",
              "jp": "すみません。もう少し、ゆっくり言ってください。",
              "bn": "দুঃখিত, আরেকটু ধীরে বলুন।"
            },
            {
              "speaker": "B",
              "jp": "傘。",
              "bn": "কাসা।"
            },
            {
              "speaker": "A",
              "jp": "ありがとうございます。",
              "bn": "ধন্যবাদ।"
            }
          ]
        },
        {
