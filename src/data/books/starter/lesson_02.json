    {
      "no": 2,
      "title": "日本語、できますか？",
      "canDo": "Can answer when someone asks if you speak Japanese and ask if someone speaks other languages.",
      "dialogues": [
        {
          "id": "s2-07",
          "title": "2-① おでん屋で",
          "lines": [
            {
              "speaker": "A",
              "jp": "はい、どうぞ。",
              "bn": "নিন।"
            },
            {
              "speaker": "B",
              "jp": "どうも。",
              "bn": "ধন্যবাদ।"
            },
            {
              "speaker": "A",
              "jp": "お客さん、日本語、できますか？",
              "bn": "আপনি কি জাপানিজ বলতে পারেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、少しできます。",
              "bn": "হ্যাঁ, একটু পারি।"
            }
          ]
        },
        {
          "id": "s2-08",
          "title": "2-② 役所で",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、読んでください。日本語、わかりますか？",
              "bn": "এটা পড়ুন। জাপানিজ বোঝেন?"
            },
            {
              "speaker": "B",
              "jp": "すみません。わかりません。",
              "bn": "দুঃখিত, বুঝি না।"
            },
            {
              "speaker": "A",
              "jp": "じゃあ、英語、わかりますか？",
              "bn": "তাহলে ইংরেজি বোঝেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、わかります。",
              "bn": "হ্যাঁ, বুঝি।"
            }
          ]
        },
        {
          "id": "s2-09",
          "title": "2-③ テーマパークで",
          "lines": [
            {
              "speaker": "A",
              "jp": "あのう、中国語、できますか？",
              "bn": "মানে, চীনা ভাষা পারেন?"
            },
            {
              "speaker": "B",
              "jp": "はい、できます。我可以幫你嗎？",
              "bn": "হ্যাঁ, পারি। (চীনা: আমি কি সাহায্য করব?)"
            }
          ]
        },
        {
          "id": "s2-10",
          "title": "2-④ インドネシア料理店で",
          "lines": [
