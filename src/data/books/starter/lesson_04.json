      "title": "夫と子どもです",
      "canDo": "Can listen to a family being introduced and understand who is who.",
      "dialogues": [
        {
          "id": "s4-03",
          "title": "1-① 道で",
          "lines": [
            {
              "speaker": "下山",
              "jp": "あれ？ ヒマルさん？",
              "bn": "আরে? হিমাল-সান?"
            },
            {
              "speaker": "ヒマル",
              "jp": "ああ、下山先生。こんにちは。",
              "bn": "ও, শিমোয়ামা শিক্ষক। শুভ দিন।"
            },
            {
              "speaker": "下山",
              "jp": "こんにちは。ヒマルさん、えーと、妻です。",
              "bn": "শুভ দিন। হিমাল-সান, ইয়ে, ইনি আমার স্ত্রী।"
            },
            {
              "speaker": "ヒマル",
              "jp": "ヒマルです。よろしくお願いします。",
              "bn": "আমি হিমাল। আপনার সাথে পরিচিত হয়ে ভালো লাগলো।"
            }
          ]
        },
        {
          "id": "s4-04",
          "title": "1-② スーパーで",
          "lines": [
            {
              "speaker": "井上",
              "jp": "ああ、呉さん。",
              "bn": "ও, গো-সান।"
            },
            {
              "speaker": "呉",
              "jp": "あ、井上さん、こんにちは。",
              "bn": "ও, ইনোউয়ে-সান, শুভ দিন।"
            },
            {
              "speaker": "井上",
              "jp": "こんにちは。呉さん、夫と子どもです。",
              "bn": "শুভ দিন। গো-সান, আমার স্বামী ও সন্তান।"
            },
            {
              "speaker": "井上(夫)",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            },
            {
              "speaker": "井上(子ども)",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            },
            {
              "speaker": "呉",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            }
          ]
        },
        {
          "id": "s4-05",
          "title": "1-③ 工場の事務所で",
          "lines": [
            {
              "speaker": "大川",
              "jp": "えっと、紹介します。こちら、リナさん。",
              "bn": "ইয়ে, পরিচয় করিয়ে দিই। ইনি রিনা-সান।"
            },
            {
              "speaker": "リナ",
              "jp": "はじめまして。リナです。",
              "bn": "প্রথম পরিচয়। আমি রিনা।"
            },
            {
              "speaker": "大川",
              "jp": "リナさん、父です。",
              "bn": "রিনা-সান, আমার বাবা।"
            },
            {
              "speaker": "大川(父)",
              "jp": "よろしく。",
              "bn": "ভালো লাগলো।"
            },
            {
              "speaker": "大川",
              "jp": "母です。",
              "bn": "আমার মা।"
            },
            {
              "speaker": "大川(母)",
              "jp": "リナさん、どうぞよろしく。",
              "bn": "রিনা-সান, দয়া করে ভালো সম্পর্ক রাখবেন।"
            },
            {
              "speaker": "大川",
              "jp": "兄です。",
              "bn": "আমার ভাই।"
            },
            {
              "speaker": "大川(兄)",
              "jp": "よろしく。",
              "bn": "ভালো লাগলো।"
            },
            {
              "speaker": "リナ",
              "jp": "よろしくお願いします。",
              "bn": "আপনার সাথে পরিচিত হয়ে ভালো লাগলো।"
            }
          ]
        },
        {
