    {
      "no": 2,
      "title": "25歳です",
      "canDo": "Can ask and answer questions about where you live and your age.",
      "dialogues": [
        {
          "id": "s4-08",
          "title": "2-① 上田さんの家で",
          "lines": [
            {
              "speaker": "ミロ",
              "jp": "ミロです。フィリピンから来ました。よろしくお願いします。",
              "bn": "আমি মিরো। ফিলিপাইন থেকে এসেছি। ভালো লাগলো।"
            },
            {
              "speaker": "上田",
              "jp": "ミロさん、うちの家族です。妻と子ども。それから、父です。",
              "bn": "মিরো-সান, আমার পরিবার। স্ত্রী ও সন্তান। আর বাবা।"
            },
            {
              "speaker": "上田(妻・父)",
              "jp": "ミロさん、よろしく。",
              "bn": "মিরো-সান, ভালো লাগলো।"
            },
            {
              "speaker": "ミロ",
              "jp": "あのう、お名前は？",
              "bn": "মানে, তোমার নাম কী?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "伸一です。",
              "bn": "শিনইচি।"
            },
            {
              "speaker": "ミロ",
              "jp": "しんいち。何歳ですか？",
              "bn": "শিনইচি। কত বছর বয়স?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "……。",
              "bn": "……।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "いくつですか？",
              "bn": "কত (বছর)?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "4歳です。",
              "bn": "৪ বছর।"
            },
            {
              "speaker": "ミロ",
              "jp": "4歳。そうですか。",
              "bn": "৪ বছর। আচ্ছা।"
            },
            {
              "speaker": "上田(父)",
              "jp": "ミロさんは、何歳？",
              "bn": "মিরো-সান, আপনার বয়স কত?"
            },
            {
              "speaker": "ミロ",
              "jp": "25歳です。",
              "bn": "২৫ বছর।"
            },
            {
              "speaker": "上田(父)",
              "jp": "そう。",
              "bn": "আচ্ছা।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "どこに住んでいますか？",
              "bn": "কোথায় থাকেন?"
            },
            {
              "speaker": "ミロ",
              "jp": "赤羽です。",
              "bn": "আকাবানে।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "そうですか。ご家族は？",
              "bn": "তাই? পরিবার?"
            },
            {
              "speaker": "ミロ",
              "jp": "家族は、フィリピンに住んでいます。",
              "bn": "পরিবার ফিলিপাইনে থাকে।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "そうですか。",
              "bn": "আচ্ছা।"
            }
          ]
        },
