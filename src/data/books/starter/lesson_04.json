      "phrases": [
        {
          "jp": "何歳ですか？",
          "romaji": "Nansai desu ka?",
          "bn": "বয়স কত?",
          "note": "বয়স জিজ্ঞাসা"
        },
        {
          "jp": "おいくつですか？",
          "romaji": "Oikutsu desu ka?",
          "bn": "আপনার বয়স কত? (আরও বিনয়ী)",
          "note": "বয়স জিজ্ঞাসা"
        },
        {
          "jp": "25歳です。",
          "romaji": "Nijuugo-sai desu.",
          "bn": "২৫ বছর।",
          "note": "উদাহরণ: 25 = にじゅうご → にじゅうごさい"
        },
        {
          "jp": "99歳",
          "romaji": "kyuujuukyuu-sai",
          "bn": "৯৯ বছর",
          "note": "উদাহরণ: きゅうじゅうきゅうさい"
        },
        {
          "jp": "どこに住んでいますか？",
          "romaji": "Doko ni sunde imasu ka?",
          "bn": "কোথায় থাকেন?",
          "note": "থাকার জায়গা জিজ্ঞাসা"
        },
        {
          "jp": "赤羽に住んでいます。",
          "romaji": "Akabane ni sunde imasu.",
          "bn": "আকাবানেতে থাকি।",
          "note": "থাকার জায়গা বলা"
        },
        {
          "jp": "東京に住んでいます。",
          "romaji": "Tookyoo ni sunde imasu.",
          "bn": "টোকিওতে থাকি।",
          "note": "থাকার জায়গা বলা"
        },
        {
          "jp": "ご家族は？",
          "romaji": "Gokazoku wa?",
          "bn": "আপনার পরিবার?",
          "note": "পরিবার সম্পর্কে জিজ্ঞাসা"
        },
        {
          "jp": "家族は、フィリピンに住んでいます。",
          "romaji": "Kazoku wa, Firipin ni sunde imasu.",
          "bn": "আমার পরিবার ফিলিপাইনে থাকে।",
          "note": "পরিবারের থাকার জায়গা"
        },
        {
          "jp": "うちの家族です。",
          "romaji": "Uchi no kazoku desu.",
          "bn": "আমার/আমাদের পরিবার।",
          "note": "「うちの」= আমার / আমাদের"
        },
        {
          "jp": "それから、父です。",
          "romaji": "Sorekara, chichi desu.",
          "bn": "আর তারপর, আমার বাবা।",
          "note": "「それから」= আর তারপর"
        },
        {
          "jp": "そう。",
          "romaji": "Soo.",
          "bn": "আচ্ছা / তাই।",
          "note": "「そうですか」এর ঘরোয়া রূপ"
        }
      ]
    },
