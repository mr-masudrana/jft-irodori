  "activities": [
    {
      "no": 1,
      "title": "夫と子どもです",
      "canDo": "Can listen to a family being introduced and understand who is who.",
      "dialogues": [
        {
          "id": "s4-03",
          "title": "1-① 道で",
          "audio": "/audio/starter/04-03.mp3",
          "lines": [
            {
              "speaker": "下山",
              "jp": "あれ？ ヒマルさん？",
              "bn": "আরে? হিমাল-সান?"
            },
            {
              "speaker": "ヒマル",
              "jp": "ああ、下山先生。こんにちは。",
              "bn": "ও, শিমোয়ামা শিক্ষক। শুভ দিন।"
            },
            {
              "speaker": "下山",
              "jp": "こんにちは。ヒマルさん、えーと、妻です。",
              "bn": "শুভ দিন। হিমাল-সান, ইয়ে, ইনি আমার স্ত্রী।"
            },
            {
              "speaker": "ヒマル",
              "jp": "ヒマルです。よろしくお願いします。",
              "bn": "আমি হিমাল। আপনার সাথে পরিচিত হয়ে ভালো লাগলো।"
            }
          ]
        },
        {
          "id": "s4-04",
          "title": "1-② スーパーで",
          "audio": "/audio/starter/04-04.mp3",
          "lines": [
            {
              "speaker": "井上",
              "jp": "ああ、呉さん。",
              "bn": "ও, গো-সান।"
            },
            {
              "speaker": "呉",
              "jp": "あ、井上さん、こんにちは。",
              "bn": "ও, ইনোউয়ে-সান, শুভ দিন।"
            },
            {
              "speaker": "井上",
              "jp": "こんにちは。呉さん、夫と子どもです。",
              "bn": "শুভ দিন। গো-সান, আমার স্বামী ও সন্তান।"
            },
            {
              "speaker": "井上(夫)",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            },
            {
              "speaker": "井上(子ども)",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            },
            {
              "speaker": "呉",
              "jp": "こんにちは。",
              "bn": "শুভ দিন।"
            }
          ]
        },
        {
          "id": "s4-05",
          "title": "1-③ 工場の事務所で",
          "audio": "/audio/starter/04-05.mp3",
          "lines": [
            {
              "speaker": "大川",
              "jp": "えっと、紹介します。こちら、リナさん。",
              "bn": "ইয়ে, পরিচয় করিয়ে দিই। ইনি রিনা-সান।"
            },
            {
              "speaker": "リナ",
              "jp": "はじめまして。リナです。",
              "bn": "প্রথম পরিচয়। আমি রিনা।"
            },
            {
              "speaker": "大川",
              "jp": "リナさん、父です。",
              "bn": "রিনা-সান, আমার বাবা।"
            },
            {
              "speaker": "大川(父)",
              "jp": "よろしく。",
              "bn": "ভালো লাগলো।"
            },
            {
              "speaker": "大川",
              "jp": "母です。",
              "bn": "আমার মা।"
            },
            {
              "speaker": "大川(母)",
              "jp": "リナさん、どうぞよろしく。",
              "bn": "রিনা-সান, দয়া করে ভালো সম্পর্ক রাখবেন।"
            },
            {
              "speaker": "大川",
              "jp": "兄です。",
              "bn": "আমার ভাই।"
            },
            {
              "speaker": "大川(兄)",
              "jp": "よろしく。",
              "bn": "ভালো লাগলো।"
            },
            {
              "speaker": "リナ",
              "jp": "よろしくお願いします。",
              "bn": "আপনার সাথে পরিচিত হয়ে ভালো লাগলো।"
            }
          ]
        },
        {
          "id": "s4-06",
          "title": "1-④ イベント会場で",
          "audio": "/audio/starter/04-06.mp3",
          "lines": [
            {
              "speaker": "パト",
              "jp": "あ、石田さん。",
              "bn": "ও, ইশিদা-সান।"
            },
            {
              "speaker": "石田",
              "jp": "ああ、パトさん。紹介します。妹と弟です。",
              "bn": "ও, পাতো-সান। পরিচয় করিয়ে দিই। আমার বোন ও ভাই।"
            },
            {
              "speaker": "パト",
              "jp": "あ、はじめまして。パトです。よろしくお願いします。",
              "bn": "ও, প্রথম পরিচয়। আমি পাতো। ভালো লাগলো।"
            },
            {
              "speaker": "石田(妹)",
              "jp": "よろしくお願いします。",
              "bn": "ভালো লাগলো।"
            },
            {
              "speaker": "石田(弟)",
              "jp": "よろしくお願いします。",
              "bn": "ভালো লাগলো।"
            }
          ]
        }
      ]
    },
    {
      "no": 2,
      "title": "25歳です",
      "canDo": "Can ask and answer questions about where you live and your age.",
      "dialogues": [
        {
          "id": "s4-08",
          "title": "2-① 上田さんの家で",
          "audio": "/audio/starter/04-08.mp3",
          "lines": [
            {
              "speaker": "ミロ",
              "jp": "ミロです。フィリピンから来ました。よろしくお願いします。",
              "bn": "আমি মিরো। ফিলিপাইন থেকে এসেছি। ভালো লাগলো।"
            },
            {
              "speaker": "上田",
              "jp": "ミロさん、うちの家族です。妻と子ども。それから、父です。",
              "bn": "মিরো-সান, আমার পরিবার। স্ত্রী ও সন্তান। আর বাবা।"
            },
            {
              "speaker": "上田(妻・父)",
              "jp": "ミロさん、よろしく。",
              "bn": "মিরো-সান, ভালো লাগলো।"
            },
            {
              "speaker": "ミロ",
              "jp": "あのう、お名前は？",
              "bn": "মানে, তোমার নাম কী?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "伸一です。",
              "bn": "শিনইচি।"
            },
            {
              "speaker": "ミロ",
              "jp": "しんいち。何歳ですか？",
              "bn": "শিনইচি। কত বছর বয়স?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "……。",
              "bn": "……।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "いくつですか？",
              "bn": "কত (বছর)?"
            },
            {
              "speaker": "上田(子ども)",
              "jp": "4歳です。",
              "bn": "৪ বছর।"
            },
            {
              "speaker": "ミロ",
              "jp": "4歳。そうですか。",
              "bn": "৪ বছর। আচ্ছা।"
            },
            {
              "speaker": "上田(父)",
              "jp": "ミロさんは、何歳？",
              "bn": "মিরো-সান, আপনার বয়স কত?"
            },
            {
              "speaker": "ミロ",
              "jp": "25歳です。",
              "bn": "২৫ বছর।"
            },
            {
              "speaker": "上田(父)",
              "jp": "そう。",
              "bn": "আচ্ছা।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "どこに住んでいますか？",
              "bn": "কোথায় থাকেন?"
            },
            {
              "speaker": "ミロ",
              "jp": "赤羽です。",
              "bn": "আকাবানে।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "そうですか。ご家族は？",
              "bn": "তাই? পরিবার?"
            },
            {
              "speaker": "ミロ",
              "jp": "家族は、フィリピンに住んでいます。",
              "bn": "পরিবার ফিলিপাইনে থাকে।"
            },
            {
              "speaker": "上田(妻)",
              "jp": "そうですか。",
              "bn": "আচ্ছা।"
            }
          ]
        }
      ]
    },
