      "canDo": "Can ask and answer simple questions about a photograph, such as “who is that?”",
      "dialogues": [
        {
          "id": "s4-18",
          "title": "3-① 母の写真",
          "audio": "/audio/starter/04-18.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、だれですか？",
              "bn": "এটা কে?"
            },
            {
              "speaker": "B",
              "jp": "私の母です。ブラジルに住んでいます。",
              "bn": "আমার মা। ব্রাজিলে থাকেন।"
            },
            {
              "speaker": "A",
              "jp": "へー、そうですか。",
              "bn": "ওহ, তাই?"
            }
          ]
        },
        {
          "id": "s4-19",
          "title": "3-② 姉の子ども",
          "audio": "/audio/starter/04-19.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、だれですか？",
              "bn": "এটা কে?"
            },
            {
              "speaker": "B",
              "jp": "姉の子どもです。",
              "bn": "বোনের সন্তান।"
            },
            {
              "speaker": "A",
              "jp": "かわいいですね。いくつですか？",
              "bn": "কী কিউট! কত বছর?"
            },
            {
              "speaker": "B",
              "jp": "3歳です。",
              "bn": "৩ বছর।"
            }
          ]
        },
        {
          "id": "s4-20",
          "title": "3-③ ペットのジョン",
          "audio": "/audio/starter/04-20.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "あ、犬。かわいいですね。",
              "bn": "ও, কুকুর। কী কিউট!"
            },
            {
              "speaker": "B",
              "jp": "ありがとう。ペットのジョンです。",
              "bn": "ধন্যবাদ। আমার পোষা জন।"
            },
            {
              "speaker": "A",
              "jp": "へー、何歳ですか？",
              "bn": "ওহ, কত বছর?"
            },
            {
              "speaker": "B",
              "jp": "16歳です。",
              "bn": "১৬ বছর।"
            },
            {
              "speaker": "A",
              "jp": "16歳……。",
              "bn": "১৬ বছর…"
            },
            {
              "speaker": "B",
              "jp": "おじいさんです。",
              "bn": "বুড়ো দাদু!"
            }
          ]
        },
        {
          "id": "s4-21",
          "title": "3-④ 友だち",
          "audio": "/audio/starter/04-21.mp3",
          "lines": [
            {
              "speaker": "A",
              "jp": "これ、だれですか？ 恋人？",
              "bn": "এটা কে? প্রেমিক/প্রেমিকা?"
            },
            {
              "speaker": "B",
              "jp": "え、ああ、友だちです。",
              "bn": "এ, ও, বন্ধু।"
            },
            {
              "speaker": "A",
              "jp": "そうですか。日本に住んでますか？",
              "bn": "তাই? জাপানে থাকে?"
            },
            {
              "speaker": "B",
              "jp": "はい。東京に住んでいます。",
              "bn": "হ্যাঁ। টোকিওতে থাকে।"
            }
          ]
        }
      ]
    },
